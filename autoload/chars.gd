func data(id: String) -> Dictionary:
	return DATA.get(id, {})

func display_name(id: String) -> String:
	if id == PLAYER:
		return "Вы"
	return str(data(id).get("name", id))

func color_of(id: String) -> Color:
	return data(id).get("color", Color(0.7, 0.7, 0.7))

func full_title(id: String) -> String:
	var d := data(id)
	if d.is_empty():
		return display_name(id)
	if str(d.get("nick", "")) != "":
		return "%s «%s»" % [d["name"], d["nick"]]
	return str(d["name"])

func pair_key(a: String, b: String) -> String:
	return a + "|" + b if a < b else b + "|" + a

func find_rel(a: String, b: String) -> Dictionary:
	var k := pair_key(a, b)
	for r in REL:
		if pair_key(r["a"], r["b"]) == k:
			return r
	return {}

func relations_of(id: String) -> Array:
	var out := []
	for r in REL:
		if r["a"] == id or r["b"] == id:
			out.append(r)
	return out

func other(r: Dictionary, id: String) -> String:
	return r["b"] if r["a"] == id else r["a"]
