			]),
			o("«Скажите, кому в этом доме можно доверять».", [
				p("Скажите, кому в этом доме можно доверять."),
				s("benito", "Сара пока что слушает нужных людей. Это уже много. А Луи — считает. Тот, кто считает, обычно знает больше, чем говорит.", "player"),
				addv({"sara": 1}),
				setv({"asked_whom_trust": true}),
			]),
			o("«А если правила не сходятся?»", [
				p("А если правила не сходятся друг с другом?"),
				s("benito", "Тогда не спорьте со столом. Он старше нас обоих.", "player"),
				addv({"chaos": 1}),
				setv({"asked_rules_conflict": true}),
			]),
		], "Что вы спрашиваете?"),
		s("benito", "Ещё вопрос — и последний. Потом поздно: вопросы за столом привилегия господ."),
		ch([
			o("«Кто накрывал стол до меня?»", [
				p("Кто накрывал стол до меня?"),
				s("benito", "Многие. Все они были вы. Не смотрите так — это фигура речи.", "player"),
				n("Бенито говорит это слишком спокойно. Он не улыбается."),
				addv({"chaos": 1}),
				setv({"asked_predecessor": true}),
			]),
			o("«Где сейчас Дон?»", [
				p("Где сейчас Дон?"),
				s("benito", "Дон никогда не опаздывает. Он уже в зале. Вы его скоро увидите.", "player"),
				setv({"asked_don": true}),
			]),
			o("«Как держать бутылку, чтобы не пролить?»", [
				p("Как держать бутылку, чтобы не пролить?"),
				s("benito", "Салфетка на горлышко, мизинец вдоль стекла. Остальное — дыхание. Запомните: бокал заполняется не там, где вам кажется.", "player"),
				setv({"wine_tip": 1}),
				n("Подсказка запомнилась: золотая зона в игре с вином станет чуть шире."),
			]),
			o("«Ничего. Я готов».", [
				addv({"order": 1}),
				s("benito", "Готов. Это самое опасное слово в этом доме.", "player"),
			]),
		], "Последний вопрос."),
		s("benito", "Идите. Гости собираются."),
	]

# ───────────────────── ПОСЛЕ УЖИНА 1: горничная Лючия ─────────────────────
func interlude1() -> Array:
	var steps: Array = [
		loc("Коридор у кабинета Дона", "study"),
		n("Ночь после первого ужина. В коридоре пахнет воском и сигарами."),
		intro(["lucia"]),
		st(["lucia"]),
		s("lucia", "Простите, это вы накрывали сегодня? Я убирала после ужина — нашла вот это."),
		n("Она протягивает вам смятую бумажку: перечень цифр без подписи."),
		s("lucia", "Лежало под тарелкой Луи. Ещё: в списке на жалованье Фрэнка нет. Я проверяла. Никто не видел, как он ест."),
		clue("frank_secret"),
	]
	if has("frank_back_to_door"):
		steps += [
			s("lucia", "Стул, на котором сидел Фрэнк, я вечером развернула к столу. Утром он снова стоял спиной к двери. Сам.", "", "scared"),
			s("lucia", "Вы посадили его спиной к двери. Это плохая примета. Такого человека лучше видеть лицом.", "player", "scared"),
		]
	steps += [
		s("lucia", "Кабинет Дона запирается изнутри уже второй день. А дверь — снаружи не заперта. Странно, правда?"),
		s("lucia", "Дом помнит, как стоял, и всегда накрывает стол на шестерых. Даже когда приходят не шестеро."),
	]
	# --- судьба Антонио ---
	if has("debtor_killed"):
		steps += [
			n("За окном у чёрного хода стоит женщина в платке. Лючия смотрит на неё не отрываясь."),
			s("lucia", "Жена Антонио из порта. Третий вечер приходит спросить, будет ли он дома к ужину. Что мне ей сказать?"),
			ch([
				o("«Скажите правду. Дома он не будет».", [
					p("Скажите ей правду. Дома он не будет."),
					addv({"order": 1}),
					setv({"told_wife": true}),
					s("lucia", "Она не заплачет. Они оплакали его ещё заранее.", "player"),
				]),
				o("«Скажите: задерживается. Пусть ждёт».", [
					p("Скажите: задерживается. Пусть ждёт."),
					addv({"chaos": 1}),
					setv({"lied_wife": true}),
					s("lucia", "Ложь в этом доме работает, как свечи. Горит, пока не кончится.", "player"),
				]),
				o("Отдать ей часть своего жалованья.", [
					n("Лючия берёт конверт и молча исчезает в темноте. Через минуту женщина в платке кланяется окну."),
					setv({"helped_wife": true}),
					addv({"rose_trust": 0}),
				]),
			], "Что передать жене Антонио?"),
		]
	else:
		steps += [
			s("lucia", "А Антонио приходил с половиной суммы. Просил передать синьору Луи, что остальное — через неделю."),
			ch([
				o("Взять конверт и отнести Луи.", [
					addv({"louis_trust": 1}),
					setv({"antonio_paid": true}),
					s("lucia", "Хорошо. Хоть кто-то в этом доме возвращает долги.", "player"),
				]),
				o("Передать конверт Саре.", [
					addv({"sara": 1}),
					setv({"antonio_paid_sara": true}),
					s("lucia", "Как скажете. Но Луи это запомнит.", "player", "scared"),
				]),
				o("Отказаться: «Я только накрываю стол».", [
					addv({"order": 1}),
					s("lucia", "Тогда я оставлю это там, где нашла.", "player"),
				]),
			], "Антонио передал деньги."),
		]
	# --- записка ---
	steps += [
		ch([
			o("Отдать записку Саре.", [
				addv({"sara": 1}),
				setv({"gave_note_sara": true}),
				s("lucia", "Как скажете. Только не говорите, что я её нашла.", "player", "scared"),
			]),
			o("Вернуть записку Луи, не говоря ни слова.", [
				addv({"louis_trust": 1}),
				setv({"returned_note_louis": true}),
				s("lucia", "Вы рискуете. Но так честнее.", "player"),
			]),
			o("Положить записку обратно под тарелку: порядок есть порядок.", [
				addv({"order": 1}),
				s("lucia", "Как будто ничего и не было. Хорошо.", "player"),
			]),
		], "Что вы делаете с запиской?"),
	]
	# --- Луи появляется, если вы его защищали ---
	if has("player_supported_louis"):
		steps += [
			n("Из полутьмы появляется Луи. Он смотрит на ваши руки, а не на вас."),
			st(["lucia", "luigi"]),
			s("luigi", "Это вы… Простите, что останавливаю. Вы подвинули мне хлеб. Никто никогда не двигает мне хлеб.", "player", "relief"),
			s("luigi", "Я веду две книги. Одну — для семьи. Вторую — для себя. Если со мной что-то случится, у каждой будут свои хозяева.", "player", "scared"),
			ch([
				o("Спросить, где хранится вторая книга.", [
					p("Где вы держите вторую книгу?"),
					s("luigi", "В нижнем ящике кабинета. Вот ключ. Если придёт Сара — лучше, чтобы у неё его не было.", "player", "scared"),
					setv({"ledger_key": true}),
					addv({"louis_trust": 1}),
					clue("luigi_secret"),
				]),
				o("Сказать, что не хотите ничего знать.", [
					p("Я ничего не хочу знать, синьор Луи."),
					addv({"order": 1}),
					s("luigi", "Мудро. И… спасибо. Всё равно.", "player", "relief"),
				]),
			], "Луи доверяет вам."),
		]
	elif has("louis_alive"):
		steps += [
			n("Вдалеке по коридору проходит Луи. Увидев вас, он ускоряет шаг и прячет что-то под пиджак."),
		]
	# --- Сара появляется, если вы её поддерживали ---
	if has("player_supported_sara"):
		steps += [
			n("Шаги за вашей спиной. Лючия исчезает так быстро, будто её здесь не было."),
			st(["sara"]),
			s("sara", "Вы умеете стоять там, где нужно. Это редкость.", "player", "cold"),
			s("sara", "В этом доме скоро будет тесно. Выбирайте сторону — пока выбор бесплатный."),
			ch([
				o("«Я на вашей стороне, госпожа Сара».", [
					p("Я на вашей стороне, госпожа Сара."),
					addv({"sara": 2}),
					setv({"sara_patron": true}),
					s("sara", "Хорошо. Первое поручение: если Фрэнк появится рядом с вами — скажите мне. Сразу.", "player", "cold"),
				]),
				o("«Я накрываю стол. Стороны — не моя работа».", [
					p("Я накрываю стол. Стороны — не моя работа."),
					addv({"order": 1}),
					s("sara", "Скромность. Её тоже можно использовать.", "player", "cool"),
				]),
			], "Сара делает предложение."),
		]
	# --- финальная реплика Лючии зависит от рута ---
	steps += [st(["lucia"])]
	steps += by_lead({
		"order": [s("lucia", "Дом сегодня ровный. Свечи горят одинаково. Если так и дальше — доживём.")],
		"sara": [s("lucia", "Говорят, ключи уже у Сары. Ещё не у неё в руке — но уже у неё в мыслях.")],
		"chaos": [s("lucia", "Вы стали спокойнее к странностям. Это хорошо или плохо — я не знаю.", "player")],
		"stranger": [s("lucia", "Кто-то спрашивал о вас. Серое пальто. Не назвал имени.", "player", "scared")],
	})
	steps += [s("lucia", "Доброй ночи. Не засиживайтесь у стола.")]
	return steps

# ───────────────────── ПОСЛЕ УЖИНА 2: повар Карло ─────────────────────
func interlude2() -> Array:
	var steps: Array = [
		loc("Кухня", "kitchen"),
		n("Кухня после второго ужина. Огонь едва тлеет."),
		intro(["carlo"]),
		st(["carlo"]),
		s("carlo", "Тарелка Дона вернулась нетронутой. Как вчера. Как позавчера. Любил мясо — а сегодня даже не прикоснулся?"),
		s("carlo", "Доктор Эмиль вышел через чёрный ход с чемоданчиком. Тяжёлым. Не думаю, что с лекарствами."),
		clue("emil_secret"),
	]
	if has("callo_targeted"):
		steps += [s("carlo", "Рыбу из восточного района больше не возят. Говорят, там теперь очень тихо. Знаете, о ком я?", "", "grim")]
	else:
		steps += [s("carlo", "А рыбак из восточного района присылал свежую камбалу. Значит, Калло ещё дышит. И пока хорошо себя ведёт.")]
	if has("corrected_name"):
		steps += [s("carlo", "Слышал, вы поправили Дона за столом. Он назвал её Марией? Не делайте так при Саре. Она не любит, когда замечают.", "player")]
	elif has("ignored_name"):
		steps += [s("carlo", "Слышал, Дон назвал Сару Марией, а вы промолчали. Умно. Пожалуй.", "player")]
	steps += [
		s("carlo", "А вот ещё. Среди столовых приборов был нож. Не наш. Узкий. С инициалами — П. В."),
		n("Карло кладёт на стол свёрток в тряпке."),
		s("carlo", "Дон в кабинете. И в то же время он за столом. Я, может, стар и глуп, но так не бывает."),
		clue("don_secret"),
	]
	# --- штрафы за мини-игры: Карло учит ---
	if int(GameState.v("clumsy")) >= 1:
		steps += [
			s("carlo", "И ещё. Вы пролили или испортили не один раз. Весь дом знает. Показать, как не пересаливать?", "player"),
			ch([
				o("«Покажите».", [
					p("Покажите, пожалуйста."),
					s("carlo", "Огонь — на слух, а не на глаз. Когда шипит ровно — снимайте. Запомните ритм.", "player"),
					setv({"dish_tip": 1}),
					n("Подсказка запомнилась: зелёная зона в готовке станет шире."),
				]),
				o("«Сам справлюсь».", [
					addv({"order": 1}),
					s("carlo", "Гордый. Хорошо. Только гордые обычно и пересаливают.", "player"),
				]),
			], "Карло готов помочь."),
		]
	else:
		steps += [s("carlo", "А вы не пролили ни капли. Хорошая рука. Берегите её — здесь на неё скоро будет много охотников.", "player")]
	# --- Эмиль, если вы его унизили ---
	if has("emil_grudge") or int(GameState.tension.get("emil", 0)) >= 2:
		steps += [
			n("Из кладовой выходит Эмиль. Закатывает рукава, моет руки у раковины."),
			st(["carlo", "emil"]),
			s("emil", "Врач запоминает тех, кто сажает его в конец стола. Это профессиональное.", "player", "cool"),
			s("emil", "Выпейте чаю. Ромашка. Очень успокаивает. Вам нужно спать, вы устали."),
			ch([
				o("Выпить чай.", [
					n("Чай горький. Через минуту вы действительно хотите спать."),
					addv({"chaos": 1}),
					setv({"tea_drunk": true}),
					s("emil", "Вот и хорошо. Спокойный человек — удобный человек.", "player", "cool"),
				]),
				o("«Спасибо, я не пью чай в чужих кухнях».", [
					addv({"order": 1}),
					setv({"tea_refused": true}),
					s("emil", "Осторожность. Её тоже стоит отметить.", "player", "cool"),
				]),
			], "Эмиль предлагает чай."),
			st(["carlo"]),
		]
	# --- Марко, если жив и выполнял заказ ---
	if has("marco_alive") and has("marco_has_job"):
		steps += [
			n("На табурете у двери сидит Марко и улыбается. Ест хлеб. Он давно тут."),
			st(["carlo", "marco"]),
			s("marco", "Луи ходит к кому-то после ужина. Ты видел? Сказать честно, я не люблю людей, которые уходят молча.", "player"),
			ch([
				o("«Видел. К чёрному ходу».", [
					p("Видел. К чёрному ходу."),
					addv({"marco_sign": 1, "louis_trust": -1}),
					setv({"told_marco_backdoor": true}),
					s("marco", "Спасибо. Ты мне нравишься. Это бывает полезно — и опасно.", "player"),
				]),
				o("«Не видел».", [
					p("Не видел."),
					addv({"louis_trust": 1}),
					setv({"lied_marco": true}),
					s("marco", "Не видел. Ну, значит, увижу сам.", "player", "cold"),
				]),
				o("«Спросите у самого Луи».", [
					p("Спросите у самого Луи."),
					addv({"marco_loyal": 1}),
					s("marco", "Умный. Я так и сделаю.", "player"),
				]),
			], "Марко задаёт вопрос."),
			st(["carlo"]),
		]
	# --- нож ---
	steps += [
		ch([
			o("Отдать нож Саре.", [
				addv({"sara": 2}),
				setv({"knife_to_sara": true}),
				s("carlo", "Она знает, что с ним делать. Лучше, чем я.", "player"),
			]),
			o("Взять нож себе и молчать.", [
				addv({"chaos": 1}),
				setv({"keeps_knife": true}),
				s("carlo", "Только не кладите его на стол. Он вам не друг.", "player", "grim"),
			]),
			o("Бросить нож в печь.", [
				addv({"order": 2}),
				setv({"knife_burned": true}),
				s("carlo", "Железо плавится, но имена остаются. Ладно. Хуже не будет.", "player"),
			]),
		], "Что вы делаете с ножом?"),
	]
	steps += by_lead({
		"order": [s("carlo", "Всё делаете по правилам. Правила тоже когда-нибудь кончаются, но не сегодня.")],
		"sara": [s("carlo", "Сара заходила на кухню днём. Спрашивала, что едят в кабинете. Я сказал: ничего.")],
		"chaos": [s("carlo", "Тарелки сами ставятся на стол в ином порядке. Я перестал удивляться. Вы тоже?", "player")],
		"stranger": [s("carlo", "Кто-то оставил на кухне серое пальто. Никто не пришёл за ним.", "", "grim")],
	})
	steps += [s("carlo", "Идите спать. Завтра ещё одно блюдо.")]
	return steps
