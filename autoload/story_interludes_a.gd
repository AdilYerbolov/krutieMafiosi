class_name StoryInterludesA
extends StoryDinners
## Интерлюдии 0–2 (пролог, после Ужина 1, после Ужина 2).
## Ветвление: по лидирующему руту (lead()) и по судьбам (флаги, которые игрок поставил на ужинах).
## ВАЖНО: условия has(...) считаются в момент начала интерлюдии; всё, что меняется
## внутри самой интерлюдии, проверяется через iff(...).

func has(cond) -> bool:
	return GameState.check(cond)

## Какой рут сейчас впереди: order | sara | chaos | stranger
func lead() -> String:
	var g := GameState
	if int(g.v("stranger")) >= 3 and g.check("stranger_noticed"):
		return "stranger"
	var o := int(g.v("order"))
	var sa := int(g.v("sara"))
	var c := int(g.v("chaos"))
	if o >= sa and o >= c:
		return "order"
	if sa >= c:
		return "sara"
	return "chaos"

func by_lead(d: Dictionary) -> Array:
	return d.get(lead(), d.get("default", []))

# ───────────────────── ПРОЛОГ: дворецкий объясняет правила дома ─────────────────────
