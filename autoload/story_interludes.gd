class_name StoryInterludes
extends StoryInterludesA
## Интерлюдии 3–5, диспетчер и концовки (с эпилогом по судьбам персонажей).

func interlude(i: int) -> Array:
	match i:
		0: return interlude0()
		1: return interlude1()
		2: return interlude2()
		3: return interlude3()
		4: return interlude4()
		5: return interlude5()
	return []

# ───────────────────── ПОСЛЕ УЖИНА 3: отец Анджело ─────────────────────
func interlude3() -> Array:
	var steps: Array = [
		loc("Коридор у часовни", "hall"),
		n("Ночь после семейного ужина. Из часовни пробивается дрожащий свет."),
		intro(["angelo"]),
		st(["angelo"]),
		s("angelo", "Я слышал, Джо опять рассказывал. Он не лжёт, сын мой. Он помнит то, чего больше нет.", "", "sad"),
		s("angelo", "В этом доме было три Дона, а в записях один. Были другие ужины. Другие гости. Всё это ушло, но не исчезло."),
		clue("joe_secret"),
	]
	if has("joe_version_strong"):
		steps += [s("angelo", "Вы не поправили его за столом. Теперь его слова ходят за вами по дому. Это бывает: чужая память прилипает, как смола.", "player", "sad")]
	elif has("corrected_joe"):
		steps += [s("angelo", "Вы поправили старика. Мало кто смеет. Только он всё равно скажет по-своему: ему нужны не вы, ему нужен стол.", "player")]
	# --- Роза ---
	if int(GameState.v("rose_trust")) >= 1 or has("rose_near_joe"):
		steps += [
			n("На скамье у часовни сидит Роза с салфеткой в руках. Она стирает с неё записи."),
			st(["angelo", "rose"]),
			s("rose", "Вы не могли бы поговорить со мной? Я не хотела при отце Анджело, но… ладно.", "player", "scared"),
			s("rose", "Я ищу имена. Я не должна была вам говорить, но вы единственный, кто заметил пустой стул."),
			ch([
				o("Назвать ей имена тех, кто уже «выбыл».", [
					p("Антонио. Калло. И, кажется, самого Дона."),
					addv({"rose_trust": 2}),
					setv({"rose_has_names": true}),
					clue("rose_secret"),
					s("rose", "Спасибо. Я запомню. Вы не знаете, как это важно.", "player", "scared"),
				]),
				o("Отказать: «Не просите об этом».", [
					p("Не просите. Я здесь, чтобы накрывать стол."),
					addv({"order": 1}),
					setv({"refused_rose": true}),
					s("rose", "Понимаю. Простите.", "player", "scared"),
				]),
				o("Посоветовать уйти из дома, пока не поздно.", [
					p("Уходите. Пока ещё можно."),
					addv({"rose_trust": 1}),
					setv({"rose_warned": true}),
					s("rose", "Я не могу. Если уйду — не узнаю, чем всё закончится.", "player", "scared"),
				]),
			], "Роза просит о помощи."),
			st(["angelo"]),
		]
	if has("sara_uses_rose"):
		steps += [
			s("angelo", "Сара расспрашивала меня о девочке. Кто её привёл? Когда? Слишком много «когда» для обычного ужина.", "", "sad"),
			ch([
				o("Предупредить Розу о Саре.", [
					addv({"rose_trust": 1, "chaos": 1}),
					setv({"rose_warned_sara": true}),
					s("angelo", "Хорошо. Предупреждённый хотя бы выбирает, как умереть.", "player", "sad"),
				]),
				o("Передать Саре, что Роза любопытна.", [
					addv({"sara": 2, "rose_trust": -1}),
					setv({"betrayed_rose": true}),
					s("angelo", "Я ничего не слышал. Совсем ничего.", "player", "sad"),
				]),
			], "Сара присматривается к Розе."),
		]
	# --- «Дон» ---
	if GameState.has_clue("don_secret"):
		steps += [
			s("angelo", "Вы знаете про Дона. Я вижу по лицу. Дон не был на исповеди с лета. Исповедоваться приходит кто-то другой его голосом.", "player", "sad"),
			ch([
				o("Попросить отпеть Дона, пока тот «живёт».", [
					p("Отпойте его, отец Анджело. Пока он сидит с нами."),
					addv({"order": 2}),
					setv({"don_blessed": true}),
					s("angelo", "Это опасно: те, кого отпели при жизни, обычно уходят быстрее. Но так честнее.", "player", "sad"),
				]),
				o("Попросить молчать. Пусть всё идёт как идёт.", [
					addv({"chaos": 1}),
					s("angelo", "Молчание тоже молитва. Только некому её слушать.", "player", "sad"),
				]),
			], "Что делать с «Доном»?"),
		]
	# --- Джо, если его версия сильна ---
	if int(GameState.v("joe_strong")) >= 1:
		steps += [
			n("У алтаря на коленях стоит Джо. Свечи вокруг него горят чуть выше, чем нужно."),
			st(["angelo", "joe"]),
			s("joe", "А, молодой человек. Вы помните Сальваторе? Нет? Странно. Он вас знал.", "player"),
			ch([
				o("Выслушать до конца.", [
					addv({"chaos": 2, "joe_strong": 1}),
					setv({"joe_token": true}),
					s("joe", "Вот. Возьмите. Это его запонка. Он велел отдать тому, кто накроет стол в последний раз.", "player"),
					n("В вашей ладони — запонка с вытертой монограммой. Вы не помните, откуда она у вас."),
				]),
				o("Уйти, не дослушав.", [
					addv({"order": 1}),
					s("joe", "Уйти — тоже ответ, сынок. Только стол его не принимает.", "player"),
				]),
			], "Джо говорит с вами."),
			st(["angelo"]),
		]
	steps += [
		s("angelo", "Решите, чью версию вы носите в себе."),
		ch([
			o("Принять версию Джо: «Расскажите, как было на самом деле».", [
				addv({"chaos": 2, "joe_strong": 1}),
				s("angelo", "Хорошо. Слушайте внимательно. И не удивляйтесь, если слова станут вашими.", "player", "sad"),
			]),
			o("Отвергнуть: «Есть только то, что записано».", [
				addv({"order": 2}),
				s("angelo", "Записи — крепкий забор. Но за забором всё равно растёт трава.", "player", "sad"),
			]),
			o("«Кто такой Незнакомец, которого ещё нет?»", [
				addv({"stranger": 1}),
				s("angelo", "Тот, кто видит, когда все уже забыли. Не ищите его, пока он не найдёт вас сам.", "player", "sad"),
			]),
		], "Что вы отвечаете священнику?"),
	]
	steps += by_lead({
		"order": [s("angelo", "Вы держитесь за порядок, как утопающий за доску. Это не осуждение — это молитва.", "player")],
		"sara": [s("angelo", "Сара приходила за благословением. Я отказал. Впервые за сорок лет.", "", "sad")],
		"chaos": [s("angelo", "Вы спокойнее воспринимаете то, что другие боятся увидеть. Будьте осторожны: спокойствие — не то же самое, что понимание.", "player")],
		"stranger": [s("angelo", "Он был здесь утром. Стоял у алтаря и не крестился. Я спросил имя. Он поблагодарил за вопрос.", "", "sad")],
	})
	steps += [s("angelo", "Идите с миром. Если он здесь есть.")]
	return steps

# ───────────────────── ПОСЛЕ УЖИНА 4: инспектор Руджеро ─────────────────────
func interlude4() -> Array:
	var steps: Array = [
		loc("Чёрный ход. Ночь", "backdoor"),
		n("За домом дождь. Под навесом — человек в промокшем плаще."),
		intro(["ruggero"]),
		st(["ruggero"]),
		s("ruggero", "Не бойтесь, я не за вами. Я за списком. Сколько было гостей? Кто сидел рядом с Доном? Кто с ним не говорил?", "", "tense"),
	]
	if has("debtor_killed"):
		steps += [s("ruggero", "Антонио из порта нашли в канале. Руки связаны шнуром. Хорошо знакомым шнуром — из вашего дома.", "player", "tense")]
	if has("helped_wife"):
		steps += [s("ruggero", "Его жена пришла к нам и назвала вас единственным, кто дал ей денег. Я запомнил.", "player")]
	if has("callo_targeted"):
		steps += [s("ruggero", "И Калло из восточного района больше не жалуется. Совпадение, конечно.")]
	steps += [s("ruggero", "У меня есть человек за вашим столом. Он считает, он очень старается. Луи — слышали такое имя?")]
	if has("louis_alive"):
		steps += [s("ruggero", "Пока он жив, мне нужен свидетель. Не дайте ему умереть.", "player")]
	else:
		steps += [s("ruggero", "Теперь он мёртв. А значит, мне нужен новый свидетель. Вы.", "player", "tense")]
	steps += [
		s("ruggero", "И ещё. Тот человек в сером. Он есть на фото из архива. В каждом десятилетии. В пальто того же покроя."),
		clue("stranger_secret"),
	]
	if has("ledger_key"):
		steps += [
			n("Вы нащупываете в кармане ключ Луи."),
			ch([
				o("Показать Руджеро вторую книгу Луи.", [
					addv({"chaos": 2}),
					setv({"gave_ledger_police": true}),
					s("ruggero", "Это то, чего мне не хватало. Дом начнёт рушиться — но уже по моим правилам.", "player"),
				]),
				o("Оставить ключ при себе.", [
					addv({"order": 1}),
					s("ruggero", "Как знаете. Ключи надолго не хранят: они ржавеют или открывают не то.", "player"),
				]),
			], "У вас ключ от книги Луи."),
		]
	steps += [
		ch([
			o("Отдать инспектору список гостей.", [
				addv({"chaos": 1, "louis_trust": -1}),
				setv({"gave_police_list": true}),
				s("ruggero", "Правильное решение. Возможно, единственное, которое вам зачтётся.", "player"),
			]),
			o("Отказаться: «Я только накрываю стол».", [
				addv({"order": 2}),
				s("ruggero", "Стол сам вас не защитит. Но дело ваше.", "player"),
			]),
			o("Расспросить о Незнакомце.", [
				addv({"stranger": 2}),
				setv({"stranger_noticed": true}),
				s("ruggero", "Я не знаю, кто он. Но знаю, чего он ждёт: когда кто-то спросит его вслух.", "player"),
			]),
		], "Инспектор ждёт ответа."),
	]
	# --- Луи, если жив ---
	if has("louis_alive"):
		steps += [
			n("Хлопает дверь. На ступенях появляется Луи с зонтом, замечает инспектора — и замирает."),
			st(["ruggero", "luigi"]),
			s("luigi", "Я… я не знал, что вы тут. Мне нужен воздух.", "", "scared"),
			s("luigi", "В среду я уезжаю. Мне нужна машина к чёрному ходу. Вечером. Тихо. Кроме вас, просить некого.", "player", "scared"),
			ch([
				o("Помочь: «Машина будет».", [
					p("Машина будет. Ждите у ворот."),
					addv({"louis_trust": 2}),
					setv({"louis_helped": true}),
					s("luigi", "Спасибо. Я этого не забуду. Если буду жив — не забуду.", "player", "relief"),
				]),
				o("Отказать: «Вы сами выбрали эту работу».", [
					addv({"order": 1}),
					s("luigi", "Да. Выбрал. Простите, что спросил.", "player", "scared"),
				]),
				o("Намекнуть Саре.", [
					addv({"sara": 2, "louis_trust": -2}),
					setv({"betrayed_louis": true}),
					s("luigi", "Вы так на меня смотрите… Нет. Ничего.", "player", "scared"),
				]),
			], "Луи просит о машине."),
			st(["ruggero"]),
		]
	# --- Марко, если жив и ему дали знак ---
	if has("marco_alive") and int(GameState.v("marco_sign")) >= 2:
		steps += [
			n("Из-за угла выходит Марко. Улыбка висит на лице, как забытое пальто."),
			st(["marco"]),
			s("marco", "Мне нужен Луи. Заказ не ждёт. Вы кивнули мне за столом. Помните?", "player", "cold"),
			ch([
				o("«Луи ушёл. Куда — не знаю».", [
					addv({"louis_trust": 1, "marco_loyal": 1}),
					setv({"hid_louis": true}),
					s("marco", "Хорошо. Попробую поверить.", "player", "cold"),
				]),
				o("«Он у чёрного хода».", [
					addv({"marco_sign": 1, "louis_trust": -1}),
					setv({"gave_louis_marco": true}),
					s("marco", "Спасибо. Дом вас запомнит как дружелюбного человека.", "player"),
				]),
				o("«Отмените заказ. Сейчас же».", [
					addv({"marco_loyal": 2, "order": 1}),
					setv({"marco_defied": true}),
					s("marco", "Ха. Смелый. Дом таких любит. Сначала.", "player", "cold"),
				]),
			], "Марко ищет Луи."),
			st(["ruggero"]),
		]
	# --- Сара, если её рут впереди ---
	if lead() == "sara" and int(GameState.v("sara")) >= 4:
		steps += [
			n("У ворот тормозит чёрная машина. Из неё выходит Сара. Дождь расступается перед ней."),
			st(["ruggero", "sara"]),
			s("sara", "Инспектор. Вы поздно приехали. Вечер уже закончился.", "", "cold"),
			s("ruggero", "Госпожа Сара. А я как раз беседовал с вашим клерком.", "", "tense"),
			s("sara", "Тогда продолжайте. Только не здесь.", "player", "cold"),
			ch([
				o("Помочь Саре: «Инспектор, вам нужно уйти».", [
					addv({"sara": 2}),
					setv({"helped_sara_ruggero": true}),
					s("sara", "Вы быстро учитесь.", "player", "cold"),
				]),
				o("Встать между ними: «Не здесь, госпожа Сара».", [
					addv({"order": 2}),
					setv({"protected_ruggero": true}),
					s("sara", "Запомню, что вы это сделали.", "player", "cold"),
				]),
			], "Сара находит инспектора."),
			st(["ruggero"]),
		]
	# --- Незнакомец ---
	if lead() == "stranger" or has("stranger_noticed"):
		steps += [
			n("Дождь не касается серого пальто. Незнакомец стоит там, где только что никого не было."),
			st(["stranger"]),
			s("stranger", "Спасибо, что спросили. Здесь почти никто не спрашивает.", "player"),
			ch([
				o("«Кто вы?»", [
					p("Кто вы?"),
					addv({"stranger": 1}),
					setv({"asked_stranger_who": true}),
					s("stranger", "Тот, кто остаётся, когда все ушли. Не больше.", "player"),
				]),
				o("«Как отсюда выйти?»", [
					p("Как отсюда выйти?"),
					addv({"stranger": 2}),
					setv({"knows_exit": true}),
					clue("stranger_secret"),
					s("stranger", "Отодвинуть стул. Не оборачиваясь. Это единственное правило, которое здесь не соблюдают.", "player"),
				]),
				o("Молча уйти в дом.", [
					addv({"order": 1}),
					s("stranger", "Тоже вариант. До встречи.", "player"),
				]),
			], "Незнакомец заговорил."),
		]
	steps += [st(["ruggero"]), s("ruggero", "Идите. Пока вас не хватились.", "", "tense")]
	return steps

# ───────────────────── ПОСЛЕ УЖИНА 5: Бенито в пустой столовой ─────────────────────
func interlude5() -> Array:
	var steps: Array = [
		loc("Пустая столовая", "empty"),
		n("Ночь перед последним ужином. Свечи погашены, но стол слегка светится."),
		st(["benito"]),
		s("benito", "Вы накрывали этот стол и раньше. Я тоже не помню, сколько раз.", "", "tired"),
		s("benito", "Каждый раз он кончается одинаково — кто-то остаётся, а кто-то нет. Меняется только список."),
	]
	# --- судьбы: кто остался, кто нет ---
	if has("louis_fled"):
		steps += [s("benito", "Луи уехал. В машине, которую вы ему заказали. Если выбрался — это единственная хорошая новость за последние месяцы.", "player")]
	elif not has("louis_alive"):
		steps += [s("benito", "Луи больше нет. Ни в книгах, ни за столом. Только цифры, которые он не успел свести.", "", "tired")]
	else:
		steps += [s("benito", "Луи ещё в доме. Считает ночами. Не пускайте его к кабинету — а то сосчитает лишнее.")]
	if has("marco_alive") and int(GameState.v("marco_loyal")) >= 2:
		steps += [
			s("benito", "Марко больше не работает на Сару. Говорит, что ждёт приказа от вас. Странное слово «приказ» в вашем адресе.", "player"),
			setv({"marco_ally": true}),
		]
	elif has("marco_alive") and int(GameState.v("sara")) >= 4:
		steps += [
			s("benito", "Марко больше не придёт. Сара убирает тех, кто выполнил заказ — и тех, кто не успел.", "", "tired"),
			setv({"marco_alive": false}),
			addv({"casualties": 1}),
		]
	elif has("marco_alive"):
		steps += [s("benito", "Марко ещё в доме. Улыбается в зеркала. Не знаю, надолго ли.")]
	else:
		steps += [s("benito", "Марко — тоже. Те, кто делают чужую работу, редко доживают до конца списка.", "", "tired")]
	if has("rose_has_names"):
		steps += [s("benito", "Роза ушла сегодня днём. Забрала салфетку с именами. Живой. Пока.")]
	elif has("rose_warned"):
		steps += [s("benito", "Роза ещё здесь. Не ушла. Говорит, что хочет досмотреть до конца.")]
	if has("don_blessed"):
		steps += [s("benito", "Дона отпели. При свече и без гостей. Теперь он за столом — но уже не держит его. Спросите у стола, что это значит.", "", "tired")]
	steps += [s("benito", "Завтра вы накроете стол в последний раз. Как — ваше дело.")]
	# --- рутовая сцена ---
	match lead():
		"order":
			steps += [
				n("Бенито достаёт из кармана тяжёлый ключ. На брелоке выгравирован крест."),
				s("benito", "Ключ от кабинета Дона. Если хотите увидеть — вот. Только не вздумайте в нём сидеть."),
				loc("Кабинет Дона", "study"),
				n("Кабинет пуст. На столе — кольцо с печатью и стопка карточек с расписанием ужинов, исписанная чужим, но очень аккуратным почерком."),
				ch([
					o("Положить кольцо на место во главе стола, где оно должно лежать.", [
						addv({"order": 2}),
						setv({"ring_on_table": true}),
						n("Кольцо ложится на скатерть, как будто лежало там всегда."),
					]),
					o("Оставить кольцо у себя.", [
						addv({"chaos": 1}),
						setv({"ring_kept": true}),
						n("Кольцо тёплое. Слишком тёплое для вещи, которой не касались неделю."),
					]),
					o("Отдать кольцо Саре.", [
						addv({"sara": 2}),
						setv({"ring_to_sara": true}),
						n("Сара наденет его завтра. Или оно наденется на неё."),
					]),
				], "Что вы делаете с кольцом Дона?"),
			]
		"sara":
			steps += [
				n("За спиной Бенито появляется Сара. Она не пытается быть тихой."),
				st(["benito", "sara"]),
				s("sara", "Вы хорошо поработали. Мне нужен человек на моей стороне стола. Не за столом — у него.", "player", "cold"),
				ch([
					o("«Я буду вашим дворецким».", [
						p("Я буду вашим дворецким, госпожа Сара."),
						addv({"sara": 2}),
						setv({"sara_butler": true}),
						s("sara", "Завтра вы накроете стол для меня. Остальное решат карточки.", "player", "cold"),
					]),
					o("«Я останусь тем, кто накрывает».", [
						p("Я останусь тем, кто накрывает. Что накрывать — решите вы."),
						addv({"order": 1}),
						s("sara", "Тоже вариант. Ограниченный, но надёжный.", "player", "cold"),
					]),
					o("«Что вы сделали с Доном?»", [
						p("Что вы сделали с Доном?"),
						addv({"chaos": 1}),
						clue("sara_secret"),
						s("sara", "Я? Ничего. Он сам так решил. Разве вам не сказали?", "player", "cold"),
						n("Сара улыбается. Впервые за все ужины."),
					]),
				], "Сара говорит с вами напрямую."),
			]
		"chaos":
			steps += [
				n("В углу, у камина, стоит Фрэнк. Его раньше там не было."),
				st(["benito", "frank"]),
				s("frank", "Я не существую. Вы тоже можете. Это легче, чем кажется.", "player"),
				s("frank", "Иногда я защищаю вас. Не всегда. Но завтра — попробую."),
				ch([
					o("Занять его место за столом.", [
						addv({"chaos": 2}),
						setv({"took_frank_seat": true}),
						s("frank", "Тогда — с вами. Не оборачивайтесь на третьем тосте.", "player"),
					]),
					o("Отказаться: «Я тот, кто накрывает».", [
						addv({"order": 1}),
						s("frank", "Хорошо. Тогда я буду стоять рядом. Как всегда.", "player"),
					]),
					o("Спросить, кем он был на самом деле.", [
						addv({"stranger": 1}),
						clue("frank_secret"),
						s("frank", "Тем, кем меня запомнили. Пока помнят — существую.", "player"),
					]),
				], "Фрэнк заговорил."),
			]
		"stranger":
			steps += [
				n("Стул во главе стола поворачивается к вам. На нём сидит Незнакомец. Свечи не горят, но видно всё."),
				st(["benito", "stranger"]),
				s("stranger", "Вы почти готовы. Завтра у вас будет выбор. Один. Он не будет выглядеть как выбор.", "player"),
				ch([
					o("«Что мне нужно сделать?»", [
						addv({"stranger": 2}),
						setv({"asked_stranger_how": true}),
						s("stranger", "Не пить на третьем тосте. Отодвинуть стул. Не оборачиваться.", "player"),
					]),
					o("«Почему именно я?»", [
						addv({"stranger": 1}),
						s("stranger", "Потому что вы единственный, кто стоит, а не сидит. С этой позиции видно всё.", "player"),
					]),
					o("Сказать Бенито, что Незнакомец сидит на месте Дона.", [
						addv({"order": 2}),
						s("benito", "Я знаю. Я молчу. Это не моё дело.", "player", "tired"),
					]),
				], "Незнакомец заговорил."),
			]
	# --- последний общий выбор ---
	steps += [
		st(["benito"]),
		ch([
			o("«Я всё сделаю как положено».", [
				p("Я всё сделаю как положено. Каждому — своё место."),
				addv({"order": 2}),
				s("benito", "Вот это правильно. Только место — не всегда то, что на карточке.", "player", "tired"),
			]),
			o("«Скажите Саре — стол накрыт для неё».", [
				p("Скажите Саре: стол накрыт для неё."),
				addv({"sara": 2}),
				s("benito", "Передам. Если она ещё слушает.", "player", "tired"),
			]),
			o("«Я сяду сам. Хватит стоять у стены».", [
				p("Я сяду сам. Хватит стоять у стены."),
				addv({"chaos": 2}),
				s("benito", "Тогда кто-то другой накроет стол. Тоже вы. Другой вы.", "player", "tired"),
			]),
			o("«Кто на самом деле приглашал Незнакомца?»", [
				p("Кто на самом деле приглашал Незнакомца?"),
				addv({"stranger": 2}),
				s("benito", "Никто. В этом и дело. Приглашают тех, кого помнят. А его помнят все — сразу, но неточно.", "player", "tired"),
			], "stranger>=2"),
		], "Последняя ночь перед ужином."),
		s("benito", "Спокойной ночи. Если она будет."),
	]
	return steps

# ───────────────────────────── КОНЦОВКИ ─────────────────────────────
func ending(code: String) -> Array:
	var base: Array = []
	match code:
		"A": base = ending_a()
		"B": base = ending_b()
		"C": base = ending_c()
		"E": base = ending_e()
		_: base = ending_d()
	return base + epilogue()

func epilogue() -> Array:
	var e: Array = [wait(0.5), n("— — —")]
	if has("louis_fled"):
		e.append(n("Где-то в другом городе человек с двумя бухгалтерскими книгами выходит из банка и не оглядывается."))
	elif has("louis_alive"):
		e.append(n("Луи остался. Его цифры теперь сводятся иначе — не в вашу пользу и не против."))
	else:
		e.append(n("Луи не вернулся. Его цифры так и не сошлись."))
	if has("rose_has_names"):
		e.append(n("Роза ушла живой. Список имён лежит в чьих-то архивах. Однажды его откроют."))
	elif has("betrayed_rose"):
		e.append(n("Роза больше не задаёт вопросов. Её не нашли ни в одном из списков."))
	if has("gave_police_list") or has("gave_ledger_police"):
		e.append(n("Через неделю у ворот остановились люди в плащах. Руджеро держал в руках ваш список."))
	if has("helped_wife"):
		e.append(n("Жена Антонио получила письмо с деньгами. Подписи не было. Она узнала почерк."))
	if has("marco_ally"):
		e.append(n("Марко больше не улыбается без причины. Иногда он стоит у вашей двери — просто так."))
	if has("ring_on_table"):
		e.append(n("На скатерти во главе стола остаётся кольцо. Его никто не трогает."))
	if int(GameState.v("clumsy")) >= 4:
		e.append(n("Говорят, вы проливали вино чаще, чем говорили. Это тоже запомнили."))
	elif int(GameState.v("clumsy")) == 0:
		e.append(n("Говорят, вы не пролили ни капли. Это тоже запомнили."))
	return e

func ending_a() -> Array:
	var steps: Array = [
		loc("Главная столовая. Последняя минута", "dining_room"),
		n("Стол стоит ровно. Свечи горят ровно. Каждый сидит там, где ему положено."),
		n("Но стульев всё больше пустует: кто-то встал выйти и не вернулся, кто-то был лишь памятью."),
		st(["don"]),
		s("don", "Вы хорошо накрыли стол. Правила соблюдены. Это больше, чем многие могут сказать."),
	]
	if has("don_blessed"):
		steps += [
			s("don", "Меня отпели. Я это помню. Я пришёл попрощаться — иначе стол не отпустил бы нас обоих."),
			n("Дон встаёт. Его силуэт растворяется в дрожащем свете. Кольцо остаётся лежать на скатерти."),
		]
	else:
		steps += [s("don", "Дом ещё стоит. Пока. Спасибо вам.")]
	steps += [n("Вы не уверены, настоящий ли он. Но правила остались целы — а для вас это почти одно и то же.")]
	return steps

func ending_b() -> Array:
	var steps: Array = [
		loc("Главная столовая. Новый порядок", "dining_room"),
		st(["sara"]),
		n("Сара поднимается и садится во главе стола. Не торопясь."),
		s("sara", "Дон устал. Дону пора отдыхать. С сегодняшнего вечера за этим столом говорю я.", "player", "cold"),
		s("sara", "Реальность? Она будет такой, какой я скажу."),
	]
	if has("sara_butler") or has("sara_patron"):
		steps += [s("sara", "Вы были со мной с самого начала. Вам — место у моей правой руки. Не за столом, а чуть позади. Привыкайте.", "player", "cool")]
	elif has("ring_to_sara"):
		steps += [n("На её пальце — кольцо Дона. Оно подходит ей, как будто всегда было её.")]
	else:
		steps += [s("sara", "Спасибо, что накрыли для меня. Вы остаётесь.", "player", "cold")]
	steps += [n("Мир вокруг плывёт, но под её рукой плывёт ровно, в одну сторону.")]
	return steps

func ending_c() -> Array:
	var steps: Array = [
		loc("Главная столовая. Чужой взгляд", "dining_room"),
		n("Вы больше не сопротивляетесь. Странности становятся привычкой, как соль на скатерти."),
		n("В какой-то момент вы обнаруживаете, что сидите за столом — в гостевом кресле, с бокалом."),
		n("Кто-то другой накрывает стол. У него ваше лицо. Или ваше лицо — его."),
	]
	if has("took_frank_seat"):
		steps += [st(["frank"]), s("frank", "Вы заняли моё место. Теперь я могу уйти. Спасибо.", "player")]
	steps += [
		st(["rose"]),
		s("rose", "Теперь вы настоящий. Почти.", "player"),
		n("Вы поднимаете бокал вместе со всеми. Тост: «За то, что мы всё ещё здесь»."),
	]
	return steps

func ending_d() -> Array:
	var steps: Array = [
		loc("Пустая столовая", "empty"),
		n("Слишком много людей исчезло — убито, стёрто, забыто."),
		n("Вы стоите у стола один. Еда ещё горячая. Вино налито. Бокалы чуть запотели."),
		n("Никто не приходит."),
		wait(1.0),
	]
	if has("joe_token"):
		steps += [n("В кармане — запонка Сальваторе. Теперь это единственная вещь в доме, которая помнит чей-то голос.")]
	steps += [n("Вы садитесь на стул Дона. Стул тёплый.")]
	return steps

func ending_e() -> Array:
	var steps: Array = [
		loc("Главная столовая. Выход", "dining_room"),
		st(["stranger"]),
		s("stranger", "Вы единственный, кто спросил вслух. Это редкость.", "player"),
	]
	if has("knows_exit"):
		steps += [s("stranger", "Вы уже знаете как. Отодвиньте стул — и не оборачивайтесь. Я проверю, что вы не оглянулись.")]
	else:
		steps += [
			s("stranger", "Я могу предложить вам уйти. Из этой версии. Не спрашивайте, куда — вам всё равно не объяснят."),
			s("stranger", "Всё, что от вас требуется, — отодвинуть стул и не оборачиваться."),
		]
	steps += [
		n("Стол остаётся накрытым. Вы отодвигаете стул."),
		n("За спиной кто-то аккуратно ставит его обратно."),
	]
	return steps

func ending_title(code: String) -> String:
	match code:
		"A": return "Руут A — Порядок"
		"B": return "Руут B — Сара"
		"C": return "Руут C — Принятие хаоса"
		"D": return "Руут D — Пустой стол"
		"E": return "Руут E — Незнакомец"
	return ""
