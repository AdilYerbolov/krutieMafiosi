		s("stranger", "Благодарю за вечер. Очень познавательный стол.", "player"),
		s("sara", "Достаточно на сегодня."),
	]

# ───────────────────────────── УЖИН 5 ─────────────────────────────
func dinner5() -> Array:
	return [
		loc("Главная столовая", "dining_room"),
		n("Все делают вид, что всё в порядке."),
