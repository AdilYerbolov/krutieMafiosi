				setv({"player_defended_louis": true}),
				relc("sara", "luigi", -1),
				s("sara", "Ты слишком добр к тем, кто считает.", "player", "cold"),
				s("luigi", "Спасибо. Я… запомню.", "player", "relief"),
			]),
			o("Промолчать.", [
				setv({"louis_exposed": true}),
				n("Луи смотрит на вас так, будто вы тоже были в списке тех, кто мог его спасти."),
			]),
		], "Сара давит на Луи."),
		n("Марко поднимает глаза на вас. Улыбается. Ждёт знака."),
		ch([
			o("Едва заметно кивнуть.", [
				addv({"marco_sign": 2}),
				n("Марко кивает в ответ. Улыбка становится шире."),
			]),
			o("Покачать головой.", [
				addv({"marco_loyal": 2}),
				n("Улыбка Марко гаснет и тут же возвращается. Но ненадолго."),
			]),
			o("Сделать вид, что не заметили.", [
				n("Марко пожимает плечами. Он понял, что вы поняли."),
			]),
