func dinner6() -> Array:
	var g := GameState
	var steps: Array = [
		loc("Главная столовая", "dining_room"),
		n("Стол накрыт, как всегда. Стульев столько же. Людей — не обязательно."),
		st(["sara", "don", "frank", "rose"]),
	]
	steps += seat_reactions()
	steps += [
		s("sara", "Начнём."),
		sv("sara", "don", "Мы продолжаем, как и планировали."),
		iff("present_don", [
			s("don", "Мы всё ещё здесь. Это главное."),
		], [
			s("sara", "Дона нет. Значит, говорю я.", "", "cold"),
		]),
		s("frank", "Вы ведь тоже уже не настоящий, да?", "player"),
		sv("rose", "rose", "Вы ведь тоже уже не настоящий, да?", "player"),
		n("Двое произносят одну и ту же фразу одновременно, разными голосами."),
		s("nora", "Лоренцо, милый, подвинь мне хлеб.", "player"),
		n("Вас никогда не звали Лоренцо. Вы пододвигаете хлеб."),
	]
	if g.check("debtor_killed"):
		steps += [fx("ghost", ["g1", 8, "Антонио"]), s("sara", "Антонио, не стесняйся. Налейте ему.", "", "cold")]
	if g.check("callo_targeted"):
		steps += [fx("ghost", ["g2", 9, "Калло"]), s("sara", "Калло, садитесь. Вы сегодня говорите меньше.", "", "cold")]
	if not g.check("louis_alive") and not g.check("louis_fled"):
		steps += [fx("ghost", ["g3", 10, "Луи"]), s("sara", "Луи, сосчитай нас. Только вслух.")]
	if not g.check("marco_alive"):
		steps += [fx("ghost", ["g4", 7, "Марко"]), n("Пустой стул улыбается. Все делают вид, что так и надо.")]
	steps += [
		fx("empty_chair", [7, 3.0]),
		s("joe", "Как я говорил в прошлый раз… нет, в позапрошлый… нет — как я говорю сейчас."),
		s("joe", "Как я говорил в прошлый раз… нет — как я говорю сейчас."),
		n("Джо повторяет свою фразу чуть другими словами. Никто не замечает."),
		n("Фрэнк сидит там, где вы стоите. Он поднимает бокал и смотрит прямо на вас."),
		fx("stare", ["frank"]),
		n("Кто-то произносит тост, который вы ещё не выбрали."),
		s("stranger", "За тех, кто накрывает стол.", "player"),
		ch([
			o("«За стол. За правила. За то, чтобы всё стояло на своих местах».", [
				p("За стол. За правила. За то, чтобы всё стояло на своих местах."),
				addv({"order": 3}),
				setv({"toast_order": true}),
			]),
			o("«За новую хозяйку».", [
				p("За новую хозяйку стола."),
				addv({"sara": 3}),
				setv({"toast_sara": true}),
				s("sara", "Хороший тост.", "player", "cold"),
			]),
			o("«За то, что мы всё ещё здесь».", [
				p("За то, что мы всё ещё здесь."),
				addv({"chaos": 3}),
				setv({"toast_chaos": true}),
			]),
			o("«Я не буду пить. Я хочу уйти».", [
				p("Я не буду пить. Я хочу уйти из этой версии."),
				addv({"stranger": 3}),
				setv({"toast_stranger": true}),
				s("stranger", "Наконец-то правильный вопрос.", "player"),
			], "stranger_noticed"),
			o("Промолчать.", [
				n("Бокалы звякают без вашего голоса."),
			]),
		], "Тост. Ваши слова повторят все."),
		sv("sara", "don", "За то, что мы всё ещё здесь."),
		s("rose", "За то, что мы всё ещё здесь."),
		s("joe", "За то, что мы всё ещё здесь."),
		fx("vanish_many", [["rose", "joe", "nora", "marco", "luigi", "emil"]]),
		n("Несколько человек за столом просто исчезают. Без звука. Бокалы остаются в воздухе на мгновение дольше."),
		wait(0.6),
	]
	return steps
