class_name StoryDinners
extends StoryBase
## Диалоги шести ужинов. Строятся в момент начала ужина (флаги уже известны).

# Реакции стола на рассадку игрока — общие для всех ужинов.
func seat_reactions() -> Array:
	return [
		iff("don_displaced", [n("Дон молча смотрит на своё пустое место во главе стола. Потом садится сбоку. Никто не смеет это заметить.")]),
		iff("sara_head", [n("Сара садится во главе стола так, словно это всегда было её место.")]),
		iff("sara_right", [n("Сара справа от Дона. Её слова звучат весомее.")]),
		iff("sara_angry", [s("sara", "Конец стола. Запомню.", "", "cold")]),
		iff("luigi_humiliated", [n("Луи сидит в самом конце стола и старается занимать как можно меньше места.")]),
		iff("tension_ml", [n("Марко сидит слишком близко к Луи. Луи отодвигает бокал.")]),
		iff("table_soft", [n("Тётя Нора рядом с Доном — за столом становится чуть тише и мягче.")]),
		iff("marco_careful", [n("Марко сидит спиной к двери и то и дело косится через плечо.")]),
		iff("emil_humiliated", [s("emil", "Конец стола. Странный способ выразить уважение врачу.", "", "cool")]),
		iff("stranger_head", [n("Незнакомец сидит во главе стола. Никто не возражает.")]),
	]

# ───────────────────────────── УЖИН 1 ─────────────────────────────
func dinner1() -> Array:
	return [
		loc("Главная столовая", "dining_room"),
		n("«Сегодня без лишних людей. Только свои. Дон ждёт.»"),
		intro(["don", "sara", "luigi"]),
		intro(["marco", "nora", "frank"]),
		st(["don", "nora", "sara", "luigi"]),
		s("don", "Садитесь. Сегодня коротко."),
	] + seat_reactions() + [
		s("nora", "Как хорошо, что все собрались. Давно не было тихого вечера.", "don"),
		s("sara", "Тихого не будет. Есть вопрос."),
		s("luigi", "Может, сначала выпьем?.."),
		st(["sara", "luigi", "marco", "don"]),
		s("marco", "Я за. Потом по делу.", "luigi"),
		s("sara", "Антонио из порта. Три недели просрочки. Люди начинают разговаривать.", "don"),
		s("luigi", "Он… он обещал на этой неделе. У него семья."),
		s("sara", "У всех есть семья. Это не оправдание.", "luigi"),
		s("marco", "Могу закрыть вопрос завтра. Чисто."),
		s("don", "Мнения."),
		n("Дон смотрит на вас, потом на стол. Стол ждёт, что вы сделаете."),
		ch([
			o("Налить Саре ещё вина и встать за её спиной.", [
				p("Позвольте, госпожа Сара."),
				addv({"sara": 1, "marco_sign": 1}),
				setv({"debtor_killed": true, "marco_has_job": true, "player_supported_sara": true}),
				relc("sara", "luigi", -1),
				n("Сара принимает бокал, не глядя. Луи замечает, где вы стоите, и запоминает."),
			]),
			o("Пододвинуть Луи хлеб и встать ближе к нему.", [
				p("Вам нужно поесть, синьор Луи."),
				addv({"louis_trust": 1}),
				setv({"debtor_delayed": true, "player_supported_louis": true, "sara_noticed_weak": true}),
				relc("sara", "luigi", -1),
				n("Луи оживает. Сара отмечает про себя: у бухгалтера появился защитник."),
			]),
			o("Ничего не делать.", [
				n("Разговор идёт сам. Дон слушает ровно столько, сколько ему нужно."),
				s("don", "Пусть Марко разберётся."),
				setv({"debtor_killed": true, "marco_has_job": true}),
			]),
			o("Выйти из комнаты на минуту.", [
				fx("player_leave"),
				n("Вы вернулись, когда всё было решено. За время вашего отсутствия Сара продавила нужное ей решение."),
				addv({"stepouts": 1, "marco_sign": 1}),
				setv({"debtor_killed": true, "marco_has_job": true}),
			]),
		], "Что вы делаете?"),
		iff("debtor_killed", [
			s("sara", "Решено. Марко, завтра.", "marco"),
			s("marco", "Будет сделано."),
			s("luigi", "Он мне ещё должен…", "sara"),
			s("sara", "Тогда получишь из того, что останется.", "luigi", "cold"),
			addv({"casualties": 1}),
		], [
			s("don", "Ещё одна неделя. После — без разговоров."),
			s("sara", "Как скажете.", "don", "cold"),
			s("marco", "Жаль. Я уже настроился."),
		]),
		n("Подают горячее. Фрэнк, молчаливый, как мебель, стоит у стены и смотрит в одну точку."),
		fx("blink", ["frank", 7, 3.0]),
		ch([
			o("Посмотреть прямо на Фрэнка.", [
				fx("peek", [1.8]),
				n("Через несколько секунд Фрэнк снова стоит на своём месте. Он не двигался. Или двигался."),
				addv({"order": 1}),
			]),
			o("Не отвлекаться. Это просто игра света.", [
				addv({"chaos": 1}),
			]),
		], "Что-то не так со стулом Фрэнка."),
		s("don", "Хватит на сегодня."),
		n("Гости встают."),
		s("nora", "Ты сегодня хорошо справился. Стол был ровный.", "player"),
		iff("debtor_killed", [n("Сара коротко кивает вам. Один раз.")]),
		iff("player_supported_louis", [n("Луи уходит, не глядя на вас — но на пороге всё-таки оборачивается.")], [n("Луи уходит, не глядя ни на кого.")]),
	]

# ───────────────────────────── УЖИН 2 ─────────────────────────────
func dinner2() -> Array:
	return [
		loc("Главная столовая", "dining_room"),
		n("«Вчерашние дела нужно закрыть. И есть ещё один вопрос.»"),
		intro(["emil"]),
		st(["don", "sara", "luigi", "emil"]),
	] + seat_reactions() + [
		s("don", "Антонио."),
		iff("debtor_killed", [
			s("marco", "Вопрос закрыт. Чисто."),
			s("sara", "Хорошо."),
			s("luigi", "…деньги он так и не вернул.", "", "scared"),
		], [
			s("sara", "Он всё ещё дышит.", "don"),
			s("marco", "Я могу исправить."),
			s("don", "Пока нет."),
		]),
		s("marco", "Фрэнк сегодня стоит на другом посту. Так что ужин без лишних ушей."),
		s("emil", "Иногда, чтобы спасти тело, приходится что-то ампутировать. Это не жестокость. Это гигиена.", "don"),
		s("sara", "В восточном районе один человек разговаривает. Имя — Калло."),
		s("emil", "Я его видел. Нервный тип. Много жестикулирует, когда врёт."),
		s("luigi", "Может, просто предупредить?"),
		s("sara", "Предупреждения уже не работают.", "luigi", "cold"),
		s("marco", "Скажите когда."),
		ch([
			o("Поддержать жёсткий подход Сары.", [
				p("Если предупреждения не работают — нужно решать."),
				addv({"sara": 1, "casualties": 1}),
				setv({"callo_targeted": true, "sara_stronger": true}),
				s("sara", "Наконец-то разумный голос за этим столом.", "player"),
			]),
			o("Предложить сначала проверить информацию.", [
				p("Прежде чем действовать, стоит убедиться, что он действительно говорит."),
				addv({"louis_trust": 1, "order": 1}),
				setv({"sara_noticed_check": true}),
				s("luigi", "Да. Проверить. Это разумно.", "player", "relief"),
				s("sara", "Запомню, кто здесь любит проверять.", "player", "cold"),
			]),
			o("Промолчать.", [
				n("Дон решает сам — как обычно, в пользу Сары."),
				addv({"sara": 1, "casualties": 1}),
				setv({"callo_targeted": true}),
			]),
			o("Мягко обратить внимание Дона на то, что Луи плохо выглядит.", [
				p("Синьор Луи, кажется, нездоров."),
				setv({"louis_hint_given": true}),
				s("luigi", "Я в порядке. Просто… считаю. Много цифр в последнее время.", "player", "scared"),
				addv({"louis_trust": 1}),
			]),
		], "Что вы делаете?"),
		n("Вы разливаете вино. Дон поднимает бокал, не глядя ни на кого."),
		sv("don", "don", "Мария, налей мне ещё."),
		n("Сара наливает. Не поправляет. Как будто её всегда так звали."),
		ch([
			o("Тихо поправить: «Дон, это Сара».", [
				p("Это Сара, Дон."),
				s("don", "Что? Да. Сара. Конечно."),
				addv({"order": 1}),
				setv({"corrected_name": true}),
			]),
			o("Сделать вид, что ничего не услышали.", [
				addv({"chaos": 1}),
				setv({"ignored_name": true}),
			]),
		], "Дон ошибся именем."),
		s("luigi", "А где сегодня Фрэнк?"),
		s("marco", "Ты сам час назад говорил, что он занят.", "luigi"),
		s("luigi", "Говорил? Да. Конечно. Занят."),
		n("Подают мясо."),
		fx("item_flash", ["plate", 7, 1.6]),
		n("На секунду на столе оказывается лишний прибор. Потом его нет."),
		s("don", "Хватит. Завтра продолжим."),
		st(["don", "emil", "sara"]),
		n("Дон тяжело поднимается. Эмиль берёт его под локоть."),
		s("emil", "Позвольте, Дон. Вам нужен отдых.", "don"),
		n("Они уходят в сторону кабинета. Эмиль возвращается один через двадцать минут, вытирая руки платком."),
		s("emil", "Люди редко замечают, когда начинают болеть. До тех пор, пока не становится поздно.", "player"),
		setv({"emil_present": true, "don_dead": true}),
	]

# ───────────────────────────── УЖИН 3 ─────────────────────────────
func dinner3() -> Array:
	return [
		loc("Главная столовая", "dining_room"),
		setv({"rose_removed": false}),
		n("Ужин «по-домашнему»: скатерть чище, свечи ниже, на столе нет бумаг."),
		intro(["rose", "joe"]),
		st(["nora", "rose", "joe", "sara"]),
	] + seat_reactions() + [
		s("nora", "Как хорошо, что Роза с нами. Давно пора.", "rose"),
		s("rose", "Спасибо, что пригласили. Правда.", "nora"),
		iff("rose_near_sara", [
			s("sara", "Ты ведь учишься, Роза? Чья ты, говоришь, племянница?", "rose", "cool"),
			s("rose", "Я… двоюродная. По материнской линии.", "sara"),
			setv({"sara_uses_rose": true}),
		]),
		iff("rose_near_joe", [
			n("Роза подаётся вперёд, слушая Джо. Что-то записывает на салфетке."),
			clue("rose_secret"),
		]),
		s("joe", "В моё время такие ужины заканчивались либо свадьбой, либо похоронами. Иногда и тем, и другим."),
		s("sara", "Джо, не пугай девочку.", "joe"),
		s("joe", "Я видел, как Сара сидела во главе этого стола. Ей шло."),
		s("sara", "Ты путаешь, Джо.", "joe", "cold"),
		s("joe", "Может быть. А может, это вы все путаете."),
		n("За столом тихо. Даже Дон не поднимает глаз."),
		ch([
			o("Поправить Джо: «Дон здесь глава семьи, мистер Джо».", [
				p("Глава семьи здесь Дон Витторио, мистер Джо."),
				s("joe", "Конечно, сынок. Конечно.", "player"),
				addv({"order": 1}),
				setv({"corrected_joe": true}),
			]),
			o("Не поправлять.", [
				addv({"joe_strong": 1, "chaos": 1}),
				setv({"joe_version_strong": true}),
			]),
			o("Предложить Розе помочь на кухне — увести её из разговора.", [
				p("Роза, не поможете мне на кухне? Там нужна ещё одна пара рук."),
				setv({"rose_removed": true}),
				addv({"rose_trust": 1}),
				n("Роза уходит с вами, бросив на стол последний взгляд. Она слышала меньше, чем хотела."),
			]),
		], "Джо сказал лишнее."),
		s("joe", "Помнишь, Нора? Сара подписывала бумаги в зелёной комнате. При свечах. Дон был ещё мальчишкой."),
		s("nora", "Помню… Или нет. Это было при его отце?", "joe"),
		s("sara", "Этого не было.", "joe"),
		s("joe", "Было."),
		s("sara", "…"),
		n("Сара больше не возражает. Её не удивило ни слово — будто она сама вспомнила то же."),
		iff("!rose_removed", [
			s("rose", "Спасибо, дядя Фрэнк. Очень вкусно."),
			fx("empty_chair", [7, 3.0]),
			n("Роза смотрит на пустой стул. Стул пуст."),
			ch([
				o("Сказать Розе, что Фрэнка здесь нет.", [
					p("Фрэнка сегодня нет, Роза."),
					s("rose", "Правда? Простите. Мне показалось…", "player"),
					addv({"order": 1, "rose_trust": 1}),
					setv({"told_rose_no_frank": true}),
				]),
				o("Молча пододвинуть пустому стулу тарелку.", [
					fx("item_flash", ["plate", 7, 4.0]),
					addv({"chaos": 1}),
					setv({"fed_chair": true}),
					n("Роза благодарно улыбается вам. Или пустому стулу."),
				]),
			], "Роза говорит с пустым местом."),
		]),
		sv("don", "don", "Ха-ха-ха!"),
		fx("laugh", ["don"]),
		n("Дон смеётся — хотя никто не шутил. Смех длится на секунду дольше, чем нужно."),
		s("marco", "Старик не в себе. Или не в себе мы.", "joe"),
		s("joe", "Спросите у стола, молодой человек. Он помнит.", "marco"),
		iff("rose_near_joe", [
			s("rose", "А что было потом, Джо? После зелёной комнаты?", "joe"),
			setv({"rose_doubts": true}),
		]),
		s("don", "Мы закончим."),
	]

# ───────────────────────────── УЖИН 4 ─────────────────────────────
func dinner4() -> Array:
	return [
		loc("Главная столовая", "dining_room"),
		n("Место во главе стола пусто. Никто не спрашивает почему."),
		intro(["stranger"]),
		st(["sara", "luigi", "stranger", "marco"]),
	] + seat_reactions() + [
		s("sara", "Сегодня без лишних формальностей."),
		s("stranger", "Формальности иногда единственное, что держит людей на местах."),
		s("luigi", "Я… я не понимаю, кто это.", "sara", "scared"),
		s("sara", "Гость. Веди себя прилично.", "luigi", "cold"),
		s("marco", "У гостей обычно есть имена.", "stranger"),
		s("stranger", "Имена — это удобно. Не обязательно.", "marco"),
		ch([
			o("Предложить Незнакомцу лучшее вино и место поудобнее.", [
				p("Позвольте, сударь. Вам удобно?"),
				addv({"stranger": 2}),
